{
  "name": "evidenceops",
  "version": "0.1.0",
  "private": true,
  "description": "Production document intelligence and RAG quality workbench: cited extraction, independent verification, human review, immutable versions, evals and QA reports.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/eval.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "process:one": "tsx scripts/process-one.ts",
    "ingest:corpus": "tsx scripts/ingest-corpus.ts",
    "fixtures:generate": "tsx fixtures/generate.ts",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "drizzle-orm": "0.45.2",
    "gpt-tokenizer": "4.0.0",
    "inngest": "4.20.0",
    "mammoth": "1.12.2",
    "next": "16.3.4",
    "openai": "7.13.0",
    "pdfjs-dist": "6.3.289",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "docx": "9.7.1",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "pdf-lib": "1.17.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
