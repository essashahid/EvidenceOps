{
  "name": "evidenceops",
  "version": "0.1.0",
  "private": true,
  "description": "Production document intelligence and RAG quality workbench: cited extraction, independent verification, human review, immutable versions, evals and QA reports.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/run-evals.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-demo.ts --users-only",
    "db:reset": "tsx scripts/reset.ts",
    "process:one": "tsx scripts/process-one.ts",
    "ingest:corpus": "tsx scripts/ingest-corpus.ts",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "verify:rls": "tsx scripts/verify-rls.ts",
    "deploy:production": "tsx scripts/deploy-production.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-table": "^9.2.4",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "inngest": "4.20.0",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^1.44.0",
    "mammoth": "1.12.2",
    "next": "16.3.4",
    "openai": "7.13.0",
    "pdfjs-dist": "6.3.289",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "docx": "9.7.1",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jszip": "^3.10.2",
    "msw": "^2.15.0",
    "pdf-lib": "1.17.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
