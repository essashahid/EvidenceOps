NEXT_PUBLIC_APP_NAME=EvidenceOps

# --- Supabase (PostgreSQL + pgvector, Auth, Storage). DATABASE_URL is the Postgres connection the server uses.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgres://localhost:5432/evidenceops
TEST_DATABASE_URL=postgres://localhost:5432/evidenceops_test

# --- OpenAI. All model names are configurable. LLM_PROVIDER=mock runs the deterministic fixture-backed provider.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-5.6-luna
OPENAI_VERIFY_MODEL=gpt-5.6-luna
OPENAI_RAG_MODEL=gpt-5.6-luna
OPENAI_EVAL_MODEL=gpt-5.6-luna
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=768

# --- Inngest. JOB_DRIVER=inline processes uploads synchronously in the request (local dev and tests only).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
JOB_DRIVER=inngest

PIPELINE_VERSION=1.0.0
EXTRACT_PROMPT_VERSION=extract-v1
VERIFY_PROMPT_VERSION=verify-v1
RAG_PROMPT_VERSION=rag-v1
DRAFT_PROMPT_VERSION=draft-v1
EVAL_PROMPT_VERSION=eval-v1

AUTO_APPROVE_THRESHOLD=0.86
REVIEW_THRESHOLD=0.65

CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
RAG_TOP_K=8
VECTOR_WEIGHT=0.75
LEXICAL_WEIGHT=0.25

MAX_UPLOAD_MB=10
MAX_DOCUMENT_PAGES=50

LLM_MAX_RETRIES=3
RETRY_DELAYS_MS=2000,8000,30000

# Anonymous visitors can browse the public demo. Signed-in admins can mutate; reviewers require DEMO_MUTATIONS_ENABLED=true.
# Never publish production passwords. Use unique strong passwords when seeding production.
PUBLIC_DEMO_MODE=true
DEMO_MUTATIONS_ENABLED=false

DEMO_ADMIN_EMAIL=admin@evidenceops.local
DEMO_ADMIN_PASSWORD=
DEMO_REVIEWER_EMAIL=reviewer@evidenceops.local
DEMO_REVIEWER_PASSWORD=
DEMO_VIEWER_EMAIL=viewer@evidenceops.local
DEMO_VIEWER_PASSWORD=

# Inject a failure into every new run: "<step>" or "<step>:<attempts>", e.g. independent_verify:1
FAILURE_INJECTION_STEP=

# --- Drivers. Production: AUTH_DRIVER=database, STORAGE_DRIVER=blob. Local: local/local.
AUTH_DRIVER=local
AUTH_SECRET=change-me-to-a-long-random-string
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
SUPABASE_STORAGE_BUCKET=sources

# Private Vercel Blob token (server-only)
BLOB_READ_WRITE_TOKEN=
