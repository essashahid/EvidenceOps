# --- Database (Postgres with pgvector). Local dev: brew postgresql@17 + pgvector.
DATABASE_URL=postgres://localhost:5432/evidenceops
# Separate database for integration/e2e tests (reset between runs)
TEST_DATABASE_URL=postgres://localhost:5432/evidenceops_test

# --- LLM provider: "openai" for real models, "mock" for deterministic fixture-backed runs (tests/CI)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EXTRACTOR_MODEL=gpt-5.6-luna
OPENAI_VERIFIER_MODEL=gpt-5.6-luna
OPENAI_ANSWER_MODEL=gpt-5.6-luna
OPENAI_JUDGE_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# --- Storage: "local" (files under .data/storage) or "supabase" (Supabase Storage bucket)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage

# --- Auth: "local" (email/password in app tables, HMAC cookie) or "supabase" (Supabase Auth)
AUTH_DRIVER=local
AUTH_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sources

# --- Inngest (durable jobs). Leave keys empty for local dev with `pnpm inngest:dev`.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# "inngest" dispatches uploads to Inngest; "inline" processes synchronously in the request (dev/test only)
JOB_DRIVER=inngest

# --- Seed users (created by `pnpm db:seed`)
SEED_ADMIN_EMAIL=admin@evidenceops.local
SEED_ADMIN_PASSWORD=evidenceops-admin
SEED_REVIEWER_EMAIL=reviewer@evidenceops.local
SEED_REVIEWER_PASSWORD=evidenceops-reviewer
